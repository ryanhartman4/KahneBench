# Python
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
*.egg

# Virtual environments
.venv/
venv/

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.uv-cache/
.coverage
htmlcov/

# IDE and OS
.idea/
.vscode/
*.swp
.DS_Store

# Evaluation outputs. The published fingerprint per model under results/
# is tracked (about 30KB each). Raw per-response results are not (about
# 10MB per model). Everything from the pre-publication pilot phase lives
# in deprecated_results/ and stays out of the tree.
fingerprint_*.json
results_*.json
test_subset.json
!results/fingerprint_*.json
deprecated_results/

# Verbose run logs (run/*.sh tee output here; can be hundreds of MB)
run/logs/

# Claude Code local config
.claude/

# Internal notes and reviews. Only the two public docs are tracked.
docs/*
!docs/LIMITATIONS.md
!docs/agent-guide.md
reports/
